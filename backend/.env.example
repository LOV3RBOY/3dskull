# ── Required ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Long random string (e.g. `openssl rand -hex 32`). Signs logins and file links.
JWT_SECRET=
# Public HTTPS origin of this server, used for image links in the app.
PUBLIC_BASE_URL=https://studio.example.com
# First admin account (created on boot if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Model ──────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
AGENT_MAX_TURNS=24
AGENT_CONCURRENCY=3

# ── Atmosphere plates (optional, paid per image; off by default) ──
# none | auto | gemini | bfl | openai
IMAGE_PROVIDER=none
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
BFL_API_KEY=
BFL_MODEL=flux-2-pro
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst

# ── Server-side cut-outs (optional; the iOS app can lift subjects on-device) ──
# auto | photoroom | removebg | fal | none
CUTOUT_PROVIDER=auto
PHOTOROOM_API_KEY=
REMOVE_BG_API_KEY=
FAL_KEY=

# ── Instagram sync (official API — see docs/INSTAGRAM.md) ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SYNC_HOURS=6

# ── Misc ───────────────────────────────────────────────────
PORT=8787
DATA_DIR=./data
XS_TIMEZONE=America/Los_Angeles
RENDER_CONCURRENCY=2
# Only needed outside Docker if Playwright's Chromium lives elsewhere
CHROMIUM_PATH=
