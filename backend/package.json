{
  "name": "xs-studio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "XS Studio — agentic marketing & content generation backend for XS Nightclub (Wynn Las Vegas)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "create-user": "tsx src/scripts/create-user.ts",
    "render-samples": "tsx src/scripts/render-samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "nanoid": "^6.0.2",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
